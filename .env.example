# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth — create at https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub OAuth — create at https://github.com/settings/developers
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Resend — magic link email auth — create at https://resend.com
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=slidedude <noreply@slidedude.io>

# Upstash Redis — auto-populated when linking KV store via Vercel dashboard
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Comma-separated list of emails allowed to sign in (leave empty to allow any)
ALLOWED_EMAILS=
